{
  "expo": {
    "name": "RILIO",
    "slug": "reflectly",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "reflectly",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#8446b0"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.reflectly.app",
      "buildNumber": "1",
      "associatedDomains": [
        "applinks:reflectlymobilex.onrender.com"
      ],
      "infoPlist": {
        "LSApplicationQueriesSchemes": ["whatsapp"],
        "NSMicrophoneUsageDescription": "RILIO uses the microphone to record your video stories",
        "NSPhotoLibraryUsageDescription": "RILIO accesses your photo library to select background images"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F5F0FA"
      },
      "package": "com.reflectly.app",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "reflectlymobilex.onrender.com",
              "pathPrefix": "/s/"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "reflectly"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow RILIO to record your video stories"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#8446b0"
        }
      ],
      "expo-asset",
      "expo-font"
    ]
  }
}
