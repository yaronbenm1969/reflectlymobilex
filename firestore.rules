rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Backgrounds — publicly readable, only admin can write (via server/Admin SDK)
    match /backgrounds/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Stories — anyone can read (players load via invite code)
    // Create: auth user only; userId field must match the caller (anti-spoofing)
    // Update: any authenticated user (players bump counters & write consent fields)
    // Delete: story owner only
    match /stories/{storyId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if request.auth != null
                    && resource.data.userId == request.auth.uid;
    }

    // Reflections — all writes go through the server (Firebase Admin SDK, which
    // bypasses these rules). Direct client-side writes are blocked entirely.
    match /reflections/{reflectionId} {
      allow write: if false;
      allow read: if request.auth != null;
    }

    // Reflections as subcollection (fallback path)
    match /stories/{storyId}/reflections/{reflectionId} {
      allow write: if false;
      allow read: if request.auth != null;
    }

    // Music library — read only
    match /music/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Suno track bank — read only (writes via Admin SDK / server)
    match /suno_tracks/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Users — each user reads/writes only their own profile
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Applications — auth users can create their own only (uid must match caller)
    // Read and update remain open to any authenticated user for the approval flow
    match /applications/{applicationId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null;
    }

    // Default: deny all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
